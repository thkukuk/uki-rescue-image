#!/bin/bash

set -x
set -e

IMAGE="${IMAGE_ID}-${IMAGE_VERSION}.${ARCHITECTURE}"
IMAGE_SDBOOT="${IMAGE_ID}-${IMAGE_VERSION}.${ARCHITECTURE}"

echo "mkosi.postoutput ${IMAGE}" "$@"

SCRIPTS_DIR="scripts"
# Hack for OBS: it redefines the directories
if [ -d mkosi.output ]; then
	MKOSI_OUTPUT="mkosi.output"
else
        MKOSI_OUTPUT="/usr/src/packages/OTHER"
fi
BOOTLOADER_DIR="${MKOSI_OUTPUT}/base"

# shim + systemd-boot
echo "Building ${IMAGE_SDBOOT}.img"
case $ARCHITECTURE in
    x86-64|arm64)
        KERNEL_VERSION=$(get_kernel_version "${OUTPUTDIR}/${IMAGE}.vmlinuz")
        TEMPDIR=$(mktemp -d)
        cat <<EOF > "${TEMPDIR}/loader.conf"
timeout  5
#console-mode keep
EOF
        cat <<EOF > "${TEMPDIR}/rescue-image.conf"
title   Rescue Image ${IMAGE_VERSION}
version 1@$KERNEL_VERSION
options quiet systemd.show_status=yes
linux   /${KERNEL_VERSION}/linux
initrd  /${KERNEL_VERSION}/initrd
EOF
        cat <<EOF > "${TEMPDIR}/uki-rescue.conf"
title UKI Rescue ${IMAGE_VERSION}
efi   /uki-rescue/uki-rescue.efi
EOF
      	if [ "$ARCHITECTURE" == "x86-64" ]; then
      	  cat <<EOF > "${TEMPDIR}/memtest86.conf"
title Memtest86+
efi   /memtest86/mt86plus.efi
EOF
	fi
        # create image
        "${SCRIPTS_DIR}/create_uefi_usbstick.sh" "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"
        # copy files to image
        mmd -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 EFI EFI/BOOT loader loader/entries "$KERNEL_VERSION" uki-rescue uki-rescue/uki-rescue.efi.extra.d uki-rescue-sysexts
	if [ "$ARCHITECTURE" == "x86-64" ]; then
	    mmd -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 memtest86
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/x86_64/shim.efi" ::EFI/BOOT/BOOTX64.EFI
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/x86_64/MokManager.efi" ::EFI/BOOT/MokManager.efi
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/lib/systemd/boot/efi/systemd-bootx64.efi" ::EFI/BOOT/grub.efi
            # memtest86+
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/lib/memtest86/mt86plus.efi" ::memtest86/mt86plus.efi
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${TEMPDIR}/memtest86.conf" ::loader/entries/memtest86.conf
	else
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/aarch64/shim.efi" ::EFI/BOOT/BOOTAA64.EFI
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/share/efi/aarch64/MokManager.efi" ::EFI/BOOT/MokManager.efi
            mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${BOOTLOADER_DIR}/usr/lib/systemd/boot/efi/systemd-bootaa64.efi" ::EFI/BOOT/grub.efi
	fi
        mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${TEMPDIR}/loader.conf" ::loader/loader.conf
        rm "${TEMPDIR}/loader.conf"
        mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${TEMPDIR}/rescue-image.conf" ::loader/entries/rescue-image.conf
        rm "${TEMPDIR}/rescue-image.conf"
        mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${TEMPDIR}/uki-rescue.conf" ::loader/entries/uki-rescue.conf
        rm "${TEMPDIR}/uki-rescue.conf"
        mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${OUTPUTDIR}/${IMAGE}.vmlinuz" ::"${KERNEL_VERSION}/linux"
        mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${OUTPUTDIR}/${IMAGE}.initrd" ::"${KERNEL_VERSION}/initrd"
	# uki-rescue
	mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${OUTPUTDIR}/${IMAGE}.efi" ::"uki-rescue/uki-rescue.efi"
	# utilities is optional, can be removed if not enough memory
	mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${MKOSI_OUTPUT}/uki-rescue-utilities-${IMAGE_VERSION}.${ARCHITECTURE}.sysext.raw" ::uki-rescue/uki-rescue.efi.extra.d/
	# all sysext images in an extra directory
	mcopy -i "${OUTPUTDIR}/${IMAGE_SDBOOT}.img"@@1048576 "${MKOSI_OUTPUT}"/uki-rescue-*-"${IMAGE_VERSION}.${ARCHITECTURE}.sysext.raw" ::uki-rescue-sysexts/
        rm -rf "$TEMPDIR"
        ;;
    *)
        echo "Unsupported architecture: '$ARCHITECTURE'" >&2
        echo "No raw disk image will be generated." >&2
esac


# cleanup
rm -v "${OUTPUTDIR}/${IMAGE}"
rm -v "${OUTPUTDIR}/${IMAGE}.initrd"
rm -v "${OUTPUTDIR}/${IMAGE}.vmlinuz"
# OBS maps that read-only
if [ -w "${BOOTLOADER_DIR}" ]; then
	rm -rf "${BOOTLOADER_DIR}" ||:
fi
